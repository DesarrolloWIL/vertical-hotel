<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hotel Room Form View Extension for Website -->
    <record id="view_hotel_room_form_website" model="ir.ui.view">
        <field name="name">hotel.room.form.website</field>
        <field name="model">hotel.room</field>
        <field name="inherit_id" ref="hotel.hotel_room_view_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Website" name="website">
                    <group>
                        <group string="Website Publication">
                            <field name="website_published"/>
                            <field name="website_price" readonly="1"/>
                        </group>
                        <group string="Booking Configuration">
                            <field name="booking_advance_percentage"/>
                            <field name="min_stay_nights"/>
                            <field name="max_stay_nights"/>
                        </group>
                    </group>
                    
                    <group string="Website Description">
                        <field name="website_description" widget="html"/>
                    </group>
                    
                    <group string="Website Amenities">
                        <field name="website_amenity_ids" widget="many2many_tags"/>
                    </group>
                    
                    <group string="Website Images">
                        <field name="website_image_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <field name="image" widget="image" options="{'size': [64, 64]}"/>
                                <field name="is_main"/>
                            </tree>
                        </field>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <!-- Hotel Room Tree View Extension -->
    <record id="view_hotel_room_tree_website" model="ir.ui.view">
        <field name="name">hotel.room.tree.website</field>
        <field name="model">hotel.room</field>
        <field name="inherit_id" ref="hotel.hotel_room_view_tree"/>
        <field name="arch" type="xml">
            <field name="status" position="after">
                <field name="website_published"/>
                <field name="website_price"/>
            </field>
        </field>
    </record>

    <!-- Hotel Room Image Views -->
    <record id="view_hotel_room_image_tree" model="ir.ui.view">
        <field name="name">hotel.room.image.tree</field>
        <field name="model">hotel.room.image</field>
        <field name="arch" type="xml">
            <tree string="Room Images" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="room_id"/>
                <field name="image" widget="image" options="{'size': [64, 64]}"/>
                <field name="is_main"/>
            </tree>
        </field>
    </record>

    <record id="view_hotel_room_image_form" model="ir.ui.view">
        <field name="name">hotel.room.image.form</field>
        <field name="model">hotel.room.image</field>
        <field name="arch" type="xml">
            <form string="Room Image">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="room_id"/>
                            <field name="sequence"/>
                            <field name="is_main"/>
                        </group>
                        <group>
                            <field name="image" widget="image"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Hotel Room Image Action -->
    <record id="action_hotel_room_image" model="ir.actions.act_window">
        <field name="name">Room Images</field>
        <field name="res_model">hotel.room.image</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new room image
            </p>
            <p>
                Upload images for hotel rooms to display on the website.
            </p>
        </field>
    </record>

    <!-- Menu Item for Room Images -->
    <menuitem id="menu_hotel_room_image"
              name="Room Images"
              parent="hotel.hotel_configuration_menu"
              action="action_hotel_room_image"
              sequence="15"/>
</odoo>