<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hotel Rooms Catalog Page -->
    <template id="hotel_rooms_page" name="Hotel Rooms">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <div class="container mt-3">
                    <div class="row">
                        <div class="col-lg-12">
                            <h1 class="text-center mb-4">Our Hotel Rooms</h1>
                            
                            <!-- Search Form -->
                            <div class="card mb-4">
                                <div class="card-body">
                                    <form method="get" action="/hotel/rooms" class="row g-3">
                                        <div class="col-md-3">
                                            <label for="checkin" class="form-label">Check-in Date</label>
                                            <input type="date" class="form-control" id="checkin" name="checkin" 
                                                   t-att-value="checkin" required=""/>
                                        </div>
                                        <div class="col-md-3">
                                            <label for="checkout" class="form-label">Check-out Date</label>
                                            <input type="date" class="form-control" id="checkout" name="checkout" 
                                                   t-att-value="checkout" required=""/>
                                        </div>
                                        <div class="col-md-3">
                                            <label for="guests" class="form-label">Guests</label>
                                            <select class="form-select" id="guests" name="guests">
                                                <option value="1" t-att-selected="'selected' if str(guests) == '1' else ''">1 Guest</option>
                                                <option value="2" t-att-selected="'selected' if str(guests) == '2' else ''">2 Guests</option>
                                                <option value="3" t-att-selected="'selected' if str(guests) == '3' else ''">3 Guests</option>
                                                <option value="4" t-att-selected="'selected' if str(guests) == '4' else ''">4 Guests</option>
                                                <option value="5" t-att-selected="'selected' if str(guests) == '5' else ''">5+ Guests</option>
                                            </select>
                                        </div>
                                        <div class="col-md-3 d-flex align-items-end">
                                            <button type="submit" class="btn btn-primary w-100">Search Rooms</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                            
                            <!-- Rooms Grid -->
                            <div class="row">
                                <t t-if="not rooms">
                                    <div class="col-12 text-center">
                                        <h3>No rooms available for the selected criteria</h3>
                                        <p>Please try different dates or adjust your search parameters.</p>
                                    </div>
                                </t>
                                <t t-foreach="rooms" t-as="room">
                                    <div class="col-lg-4 col-md-6 mb-4">
                                        <div class="card h-100">
                                            <t t-if="room.website_image_ids">
                                                <t t-set="main_image" t-value="room.website_image_ids.filtered('is_main')[:1] or room.website_image_ids[:1]"/>
                                                <img t-att-src="'/web/image/hotel.room.image/%s/image/400x300' % main_image.id" 
                                                     class="card-img-top" t-att-alt="room.name" style="height: 200px; object-fit: cover;"/>
                                            </t>
                                            <t t-else="">
                                                <div class="card-img-top bg-light d-flex align-items-center justify-content-center" 
                                                     style="height: 200px;">
                                                    <i class="fa fa-bed fa-3x text-muted"></i>
                                                </div>
                                            </t>
                                            
                                            <div class="card-body d-flex flex-column">
                                                <h5 class="card-title" t-field="room.name"/>
                                                <p class="card-text flex-grow-1">
                                                    <span class="text-muted">Capacity:</span> <t t-esc="room.capacity"/> guests<br/>
                                                    <span class="text-muted">Type:</span> <t t-field="room.room_type_id.name"/>
                                                    <t t-if="room.website_description">
                                                        <br/><small t-field="room.website_description" class="text-muted"/>
                                                    </t>
                                                </p>
                                                
                                                <div class="d-flex justify-content-between align-items-center mt-auto">
                                                    <div>
                                                        <span class="h5 text-primary">$<t t-esc="'%.2f' % room.website_price"/></span>
                                                        <small class="text-muted">/night</small>
                                                    </div>
                                                    <a t-att-href="'/hotel/room/%s?checkin=%s&amp;checkout=%s&amp;guests=%s' % (room.id, checkin, checkout, guests)" 
                                                       class="btn btn-primary">View Details</a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Hotel Room Detail Page -->
    <template id="hotel_room_detail_page" name="Hotel Room Detail">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <div class="container mt-3">
                    <div class="row">
                        <div class="col-lg-8">
                            <!-- Room Images -->
                            <t t-if="room.website_image_ids">
                                <div id="roomImageCarousel" class="carousel slide mb-4" data-bs-ride="carousel">
                                    <div class="carousel-inner">
                                        <t t-foreach="room.website_image_ids" t-as="image">
                                            <div t-att-class="'carousel-item' + (' active' if image_first else '')">
                                                <img t-att-src="'/web/image/hotel.room.image/%s/image' % image.id" 
                                                     class="d-block w-100" t-att-alt="image.name" 
                                                     style="height: 400px; object-fit: cover;"/>
                                            </div>
                                        </t>
                                    </div>
                                    <t t-if="len(room.website_image_ids) > 1">
                                        <button class="carousel-control-prev" type="button" data-bs-target="#roomImageCarousel" data-bs-slide="prev">
                                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                            <span class="visually-hidden">Previous</span>
                                        </button>
                                        <button class="carousel-control-next" type="button" data-bs-target="#roomImageCarousel" data-bs-slide="next">
                                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                            <span class="visually-hidden">Next</span>
                                        </button>
                                    </t>
                                </div>
                            </t>
                            
                            <!-- Room Description -->
                            <div class="mb-4">
                                <h1 t-field="room.name"/>
                                <p class="lead">
                                    <span class="badge bg-info me-2">
                                        <i class="fa fa-users"></i> <t t-esc="room.capacity"/> guests
                                    </span>
                                    <span class="badge bg-secondary">
                                        <t t-field="room.room_type_id.name"/>
                                    </span>
                                </p>
                                
                                <t t-if="room.website_description">
                                    <div t-field="room.website_description"/>
                                </t>
                            </div>
                            
                            <!-- Amenities -->
                            <t t-if="room.website_amenity_ids">
                                <div class="mb-4">
                                    <h4>Amenities</h4>
                                    <div class="row">
                                        <t t-foreach="room.website_amenity_ids" t-as="amenity">
                                            <div class="col-md-6 mb-2">
                                                <i class="fa fa-check text-success me-2"></i>
                                                <t t-field="amenity.name"/>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </t>
                        </div>
                        
                        <div class="col-lg-4">
                            <!-- Booking Form -->
                            <div class="card sticky-top">
                                <div class="card-header">
                                    <h5 class="mb-0">Book This Room</h5>
                                </div>
                                <div class="card-body">
                                    <form id="bookingForm" method="post" action="/hotel/booking/create">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <input type="hidden" name="room_id" t-att-value="room.id"/>
                                        
                                        <div class="mb-3">
                                            <label for="checkin_date" class="form-label">Check-in Date</label>
                                            <input type="date" class="form-control" id="checkin_date" name="checkin_date" 
                                                   t-att-value="checkin" required=""/>
                                        </div>
                                        
                                        <div class="mb-3">
                                            <label for="checkout_date" class="form-label">Check-out Date</label>
                                            <input type="date" class="form-control" id="checkout_date" name="checkout_date" 
                                                   t-att-value="checkout" required=""/>
                                        </div>
                                        
                                        <div class="row mb-3">
                                            <div class="col-6">
                                                <label for="adults" class="form-label">Adults</label>
                                                <select class="form-select" id="adults" name="adults" required="">
                                                    <option value="1">1</option>
                                                    <option value="2" selected="">2</option>
                                                    <option value="3">3</option>
                                                    <option value="4">4</option>
                                                </select>
                                            </div>
                                            <div class="col-6">
                                                <label for="children" class="form-label">Children</label>
                                                <select class="form-select" id="children" name="children">
                                                    <option value="0" selected="">0</option>
                                                    <option value="1">1</option>
                                                    <option value="2">2</option>
                                                    <option value="3">3</option>
                                                </select>
                                            </div>
                                        </div>
                                        
                                        <!-- Guest Information -->
                                        <div class="mb-3">
                                            <label for="guest_name" class="form-label">Guest Name</label>
                                            <input type="text" class="form-control" id="guest_name" name="guest_name" required=""/>
                                        </div>
                                        
                                        <div class="mb-3">
                                            <label for="guest_email" class="form-label">Email</label>
                                            <input type="email" class="form-control" id="guest_email" name="guest_email" required=""/>
                                        </div>
                                        
                                        <div class="mb-3">
                                            <label for="guest_phone" class="form-label">Phone</label>
                                            <input type="tel" class="form-control" id="guest_phone" name="guest_phone"/>
                                        </div>
                                        
                                        <div class="mb-3">
                                            <label for="special_requests" class="form-label">Special Requests</label>
                                            <textarea class="form-control" id="special_requests" name="special_requests" rows="3"></textarea>
                                        </div>
                                        
                                        <!-- Price Summary -->
                                        <div id="priceSummary" class="mb-3 p-3 bg-light rounded">
                                            <div class="d-flex justify-content-between mb-2">
                                                <span>Price per night:</span>
                                                <span class="fw-bold">$<t t-esc="'%.2f' % room.website_price"/></span>
                                            </div>
                                            <div id="totalPrice" class="d-flex justify-content-between border-top pt-2">
                                                <span class="fw-bold">Total:</span>
                                                <span class="fw-bold text-primary">-</span>
                                            </div>
                                            <div id="advanceAmount" class="d-flex justify-content-between">
                                                <span>Advance Payment:</span>
                                                <span class="text-info">-</span>
                                            </div>
                                        </div>
                                        
                                        <button type="submit" class="btn btn-primary w-100">Book Now</button>
                                        
                                        <div class="mt-2 text-center">
                                            <small class="text-muted">
                                                Advance payment required: <t t-esc="room.booking_advance_percentage"/>%
                                            </small>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Booking Error Page -->
    <template id="booking_error_page" name="Booking Error">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <div class="container mt-5">
                    <div class="row justify-content-center">
                        <div class="col-lg-6 text-center">
                            <div class="alert alert-danger">
                                <h4><i class="fa fa-exclamation-triangle"></i> Booking Error</h4>
                                <p t-esc="error_message"/>
                            </div>
                            <a href="/hotel/rooms" class="btn btn-primary">Back to Rooms</a>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>